Options -Indexes

# ── MIME types untuk assets Vite ──────────────────────────────────────
AddType application/javascript .js
AddType text/css                .css
AddType application/json        .json
AddType image/svg+xml           .svg
AddType font/woff2              .woff2

# ── SPA fallback: semua request non-file → index.html ─────────────────
RewriteEngine On

# Jangan redirect jika file/folder fisik ada
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Kecuali request ke /api/ — biarkan PHP yang handle
RewriteCond %{REQUEST_URI} !^/api/

RewriteRule ^ index.html [L]

# ── Security headers ──────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP — izinkan fonts Google, Leaflet CDN, data: untuk inline SVG favicon
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.tile.openstreetmap.org; connect-src 'self' https://kasper.balmonjogja.info"
</IfModule>

# ── Cache assets Vite (nama file sudah ada hash) ─────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(js|css|woff2|svg|png|ico)$">
        ExpiresDefault "access plus 1 year"
        Header append Cache-Control "public, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
